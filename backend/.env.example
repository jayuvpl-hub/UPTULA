# Runtime
NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=https://your-production-domain.example
PUBLIC_API_URL=https://api.your-production-domain.example

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# AWS RDS (prefer Secrets Manager/SSM or task environment variables in AWS)
DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=replace-me
DB_NAME=uptula
DB_CONNECTION_LIMIT=10
DB_SSL=true

# AWS S3
# Use an EC2/ECS IAM role in production; do not put AWS access keys here.
AWS_REGION=ap-south-1
S3_BUCKET=your-private-uptula-bucket

# Razorpay live credentials
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace-me
# This is independently created when configuring the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=replace-me

# Email
EMAIL_USER=your-smtp-user
EMAIL_PASS=replace-me
NODE_ENV=development
PORT=5000
